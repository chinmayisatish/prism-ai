# PRISM AI - Environment Configuration
# Copy this file to .env and supply your API keys if available.
# PRISM AI also includes realistic mock mode if keys are not provided.

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=

# GitHub Personal Access Token (Optional, for higher rate limits and private repositories)
# Needs read access to repository contents and pull requests
GITHUB_TOKEN=

# Host & Port configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
DATABASE_PATH=prism_ai.db
DEBUG=True
